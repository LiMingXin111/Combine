# Create actual files with: python deploy/init_env.py --domain app.example.com --email admin@example.com
# No example credential is suitable for production.
COMBINE_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
COMBINE_RELEASE=20261015
DEPLOY_MODE=cloud
DATA_DIR=/data
DB_PATH=/data/combine.db
REGISTRATION_MODE=closed
COOKIE_SECURE=1
TRUST_PROXY=1
RATE_LIMIT=1
SECRETS_MASTER_KEY=
PLATFORM_BASE_URL=
PLATFORM_API_KEY=
PLATFORM_MODEL_FAST=
PLATFORM_MODEL_STANDARD=
PLATFORM_MODEL_STRONG=
LLM_TIMEOUT_S=180
GLOBAL_MAX_CONCURRENCY=8
DEFAULT_MONTHLY_QUOTA_CNY=50
WEB_SEARCH_MODE=auto
WECHAT_MODE=off
