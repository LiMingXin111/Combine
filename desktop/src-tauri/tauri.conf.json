{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Combine",
  "version": "0.2.0",
  "identifier": "com.combine.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Combine",
        "width": 1440,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 700,
        "backgroundColor": "#f9f8fc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "resources": ["resources/python/", "resources/runtime/"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser", "languages": ["English"] }
    }
  }
}
