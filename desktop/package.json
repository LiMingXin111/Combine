{
  "name": "combine-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare_assets.mjs && vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev.mjs",
    "dev:browser": "node scripts/dev.mjs --browser",
    "dev:check": "node scripts/dev.mjs --check",
    "dev:stop": "node scripts/dev.mjs --stop",
    "build": "node scripts/prepare_assets.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test:execution": "node tests/execution_visuals.mjs",
    "test:runtime": "python -m unittest discover -s tests -p test_*.py -v"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@xyflow/react": "^12.12.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiMingXin111/Combine.git"
  }
}
