# ---- 部署形态 ----
# self_hosted：在自己电脑上运行，可接入本地模型（Ollama / LM Studio / vLLM）
# cloud：部署到服务器，禁止访问私网地址、不开放本地模型
DEPLOY_MODE=self_hosted
REGISTRATION_MODE=open          # open | closed（closed 时只允许第一个用户注册）

# ---- 平台内置模型（OpenAI 兼容接口）。三项都留空 → 自动使用离线演示模型 FakeLLM ----
PLATFORM_BASE_URL=
PLATFORM_API_KEY=
PLATFORM_MODEL_FAST=
PLATFORM_MODEL_STANDARD=
PLATFORM_MODEL_STRONG=

# ---- 密钥主密钥（AES-256-GCM，加密用户自配的 API Key）。生产环境必须设置：python scripts/gen_master_key.py ----
SECRETS_MASTER_KEY=

# ---- 微信扫码登录（F30，可选）。三项齐备即自动启用；缺省或不填则登录页只显示邮箱密码 ----
# 需在微信开放平台（open.weixin.qq.com）注册「网站应用」，需企业主体并完成域名 ICP 备案；
# WECHAT_REDIRECT_URI 必须与后台登记的「授权回调域」完全一致。
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=
# live = 连接真实微信服务器；fake = 本地模拟授权页（无资质时演示与自动化测试用）；off = 关闭。
# 留空则按上面三项是否齐备自动判定。
WECHAT_MODE=
WECHAT_TICKET_TTL_S=300          # 二维码有效期（秒）

# ---- 其他 ----
DATA_DIR=./data
GLOBAL_MAX_CONCURRENCY=16
DEFAULT_TASK_BUDGET_CNY=2.0
DEFAULT_MONTHLY_QUOTA_CNY=50
COOKIE_SECURE=0                 # 通过 HTTPS 访问时设为 1
FAKE_LATENCY_SCALE=1.0          # 仅 FakeLLM：调小可加快演示，例如 0.3

# ---- 加固 ----
RATE_LIMIT=1                    # 进程内接口限流（1 开 / 0 关）
TRUST_PROXY=0                   # 位于反向代理之后时设为 1，按 X-Forwarded-For 识别客户端 IP（直接暴露在公网时必须为 0，否则可伪造）
SSE_QUEUE_MAX=1000              # 单个实时连接最多积压的事件数
BACKUP_KEEP=7                   # scripts/backup.py 默认保留份数
